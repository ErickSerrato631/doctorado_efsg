# Want you save images?  write Y o N
SAVE_IMAGES=Y




# Define constants of dynamic equations
D_c=0.012
D_s=0.022
D_i=0.022

rc=3
rs=13.12
rd=12

alpha=10.22
delta=3
beta=7
alle=0.1
gamma=0.74
eta=0.5
mu=0



# Define mesh and space
nodes_in_xaxis=100
nodes_in_yaxis=100
space_size=4

# Define time step and time interval
T=3  # final time
dt=0.001  # time step size
nb=10
# this value generates automatically, no modify
TEST_DIRECTORY="/media/erick/TOSHIBA EXT"

# Resolución de guardado y control adaptativo
sample_rate=0.02      # paso de muestreo espacial para los .txt (0.02 -> ~201x201 con space_size=4)
eps_u=0.02            # evita división por cero en u = 0.2*c/(i+eps_u)
u_max=1.0             # cota superior suave para el control adaptativo
inner_max_iter=3      # iteraciones Picard por paso de tiempo
inner_tol=1e-3        # tolerancia de convergencia interna

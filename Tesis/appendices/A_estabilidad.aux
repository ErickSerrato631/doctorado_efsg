\newlabel{fig:stability_strong_no_control}{{A.3}{44}{Espectros lineales para Allee fuerte sin control adaptativo. El efecto Allee fuerte produce barreras más pronunciadas; $\mu =1$ reduce la banda de modos inestables en altas frecuencias sin eliminar la inestabilidad en $k\approx 0$}{figure.caption.40}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {A.2.2}Casos con control adaptativo}{44}{subsection.Alph1.2.2}\protected@file@percent }

\contentsline {figure}{\numberline {4.1}{\ignorespaces Estado estacionario inestable en el plano $(c,s)$ bajo dos regímenes de \(\mu \). Izquierda: \(\mu = 0\), \(P_1 = (1.4103, 1.0414, 0.6110)\); derecha: \(\mu = 1\), \(P_1 = (1.0826, 0.4885, 0.1649)\). Las nulclinas $r_1 = 0$ (negro) y $r_2 = 0$ (azul) muestran cómo la presencia de estructura variacional modifica la geometría del flujo.}}{8}{figure.caption.7}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Distribución espacial de $c$, $s$ e $i$ a \(T=1.935\). Con $\mu =0$ se observan cúmulos caóticos; con $\mu =1$ la estructura variacional suaviza y estabiliza patrones, generando cúmulos más definidos y menos numerosos. Animaciones en \href {https://drive.google.com/drive/folders/11FhjobQToXXDddC7UCPAwGjC53Cm1i0S?usp=sharing}{enlace}.}}{13}{figure.caption.11}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Transición de espectro amplio (desorden) a bajas frecuencias (compactación) para $c$ con $\mu =1$.}}{14}{figure.caption.12}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Autocorrelación $c_c$ (células cancerosas). $\mu =1$ incrementa $\xi (t)$, indicando mayor compactación.}}{14}{figure.caption.13}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Autocorrelación $s_s$ (células sanas). $\mu =1$ produce distribución más homogénea.}}{15}{figure.caption.14}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Autocorrelación $i_i$ (sistema inmune). Diferencias leves entre $\mu =0$ y $\mu =1$.}}{15}{figure.caption.15}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Correlación cruzada $c_s$ (cáncer--sanas). Crecimiento débil de $\xi (t)$, coherente con competencia.}}{16}{figure.caption.16}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Correlación cruzada $c_i$ (cáncer--inmune). $\mu =1$ mejora seguimiento inmune de patrones tumorales.}}{16}{figure.caption.17}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Correlación cruzada $s_i$ (sanas--inmune). Es la más débil; el sistema inmune se concentra en el tumor.}}{17}{figure.caption.18}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Distribución espacial bajo efecto Allee fuerte. $\mu =0$: patrones fragmentados; $\mu =1$: dominios más definidos.}}{18}{figure.caption.19}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Autocorrelación $c_c$ con efecto Allee fuerte.}}{19}{figure.caption.20}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Autocorrelación $s_s$ (fuerte).}}{19}{figure.caption.21}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Autocorrelación $i_i$ (fuerte).}}{20}{figure.caption.22}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Correlación $c_s$ (fuerte).}}{20}{figure.caption.23}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Correlación $c_i$ (fuerte).}}{21}{figure.caption.24}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Correlación $s_i$ (fuerte).}}{21}{figure.caption.25}%

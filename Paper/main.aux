\newlabel{eq:u-hill}{{20}{5}{}{equation.4.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Spatial evolution for the strong-Allee, reciprocal-completion setting with Hill control. Each row shows a time slice from $t=0.25$ to $t=1.00$; columns show the Fickian flux fields $\mathbf  {J}_c$, $\mathbf  {J}_s$, and $\mathbf  {J}_i$ over their corresponding population densities. The initially granular texture coarsens into mesoscopic domains: cancer gradients become weak at late times, while healthy-tissue and immune fields retain aligned spatial structure, indicating coupled tissue--immune organization along common interfaces.}}{6}{figure.caption.16}\protected@file@percent }
\newlabel{fig:fields_panel_strong_mu1_u}{{2}{6}{Spatial evolution for the strong-Allee, reciprocal-completion setting with Hill control. Each row shows a time slice from $t=0.25$ to $t=1.00$; columns show the Fickian flux fields $\mathbf {J}_c$, $\mathbf {J}_s$, and $\mathbf {J}_i$ over their corresponding population densities. The initially granular texture coarsens into mesoscopic domains: cancer gradients become weak at late times, while healthy-tissue and immune fields retain aligned spatial structure, indicating coupled tissue--immune organization along common interfaces}{figure.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Correlation-length growth in the strong-Allee spatial scenarios, arranged as autocorrelations (left column: $c$--$c$, $s$--$s$, $i$--$i$) and cross-correlations (right column: $c$--$s$, $c$--$i$, $s$--$i$). Curves compare the nonreciprocal baseline and the reciprocal-completion setting, each with and without Hill adaptive control. All observables grow with exponents close to $1/2$, consistent with diffusion-limited coarsening. The prefactors carry the mechanistic information: Hill control reduces cancer-domain coherence in the nonreciprocal baseline, whereas the reciprocal-completion setting enhances immune-centered organization and cancer--immune co-localization.}}{7}{figure.caption.17}\protected@file@percent }
\newlabel{fig:corr_grid_auto_cross}{{3}{7}{Correlation-length growth in the strong-Allee spatial scenarios, arranged as autocorrelations (left column: $c$--$c$, $s$--$s$, $i$--$i$) and cross-correlations (right column: $c$--$s$, $c$--$i$, $s$--$i$). Curves compare the nonreciprocal baseline and the reciprocal-completion setting, each with and without Hill adaptive control. All observables grow with exponents close to $1/2$, consistent with diffusion-limited coarsening. The prefactors carry the mechanistic information: Hill control reduces cancer-domain coherence in the nonreciprocal baseline, whereas the reciprocal-completion setting enhances immune-centered organization and cancer--immune co-localization}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {section}{\numberline {V}Thermodynamic Diagnostic}{7}{section*.20}\protected@file@percent }
\newlabel{sec:thermodynamics}{{V}{7}{}{section*.20}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Three-dimensional homogeneous equilibria for the strong-Allee branch used in the four spatial scenarios analyzed in the manuscript, with reaction kinetics taken from \texttt  {scenarios.json}. Cases without Hill control use $u\equiv 0$, while cases with Hill control use Eq.~\eqref  {eq:u-hill}. Common Hill parameters are $K_c{=}0.05$, $n_c{=}2$, $K_i{=}0.2$, $n_i{=}2$, and $u_{\max }{=}1$. The fixed point $(c^*,s^*,i^*)$ and $\mathrm  {Re}\,\lambda _{\max }$ come from the three-dimensional fixed-point analysis with the same reaction parameters. Since the reference state has $c^*=0$, the Hill activation vanishes there and $u{=}0$ locally; the control therefore acts through spatial fluctuations and interfaces rather than by shifting the homogeneous eigenvalue. Spatial diffusion coefficients are $D_c{=}0.012$ and $D_s{=}D_i{=}0.022$. The remaining eigenvalues in this branch are $\lambda _2\approx -10.87$ for the nonreciprocal baseline or $-11.61$ for the reciprocal-completion setting, and $\lambda _3=-13.12$.}}{8}{table.caption.19}\protected@file@percent }
\newlabel{tab:control-strong}{{III}{8}{Three-dimensional homogeneous equilibria for the strong-Allee branch used in the four spatial scenarios analyzed in the manuscript, with reaction kinetics taken from \texttt {scenarios.json}. Cases without Hill control use $u\equiv 0$, while cases with Hill control use Eq.~\eqref {eq:u-hill}. Common Hill parameters are $K_c{=}0.05$, $n_c{=}2$, $K_i{=}0.2$, $n_i{=}2$, and $u_{\max }{=}1$. The fixed point $(c^*,s^*,i^*)$ and $\mathrm {Re}\,\lambda _{\max }$ come from the three-dimensional fixed-point analysis with the same reaction parameters. Since the reference state has $c^*=0$, the Hill activation vanishes there and $u{=}0$ locally; the control therefore acts through spatial fluctuations and interfaces rather than by shifting the homogeneous eigenvalue. Spatial diffusion coefficients are $D_c{=}0.012$ and $D_s{=}D_i{=}0.022$. The remaining eigenvalues in this branch are $\lambda _2\approx -10.87$ for the nonreciprocal baseline or $-11.61$ for the reciprocal-completion setting, and $\lambda _3=-13.12$}{table.caption.19}{}}

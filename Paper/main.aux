\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase portrait in the $(c,s)$ plane of the reduced two-variable kinetic model associated with the $c$ and $s$ dynamics. Red circles mark the projected stationary points collected from the local steady-state catalogs together with roots of the reduced two-dimensional system; points that are numerically very close in projection are rounded and merged. The streamlines show that the homogeneous references organize the flow as sources or saddle-like separators: trajectories are guided by invariant directions near the axes and by off-axis roots, but are not attracted to a global stable well. This geometry motivates the spatial simulations, where unstable local references seed pattern formation rather than homogeneous relaxation.}}{4}{figure.caption.14}\protected@file@percent }
\newlabel{fig:steady_states}{{1}{4}{Phase portrait in the $(c,s)$ plane of the reduced two-variable kinetic model associated with the $c$ and $s$ dynamics. Red circles mark the projected stationary points collected from the local steady-state catalogs together with roots of the reduced two-dimensional system; points that are numerically very close in projection are rounded and merged. The streamlines show that the homogeneous references organize the flow as sources or saddle-like separators: trajectories are guided by invariant directions near the axes and by off-axis roots, but are not attracted to a global stable well. This geometry motivates the spatial simulations, where unstable local references seed pattern formation rather than homogeneous relaxation}{figure.caption.14}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Projected stationary points marked in Fig.~\ref {fig:steady_states}, with the corresponding immune coordinate $i^*$. For roots obtained from the reduced $(c,s)$ system, $i^*$ is reconstructed from the algebraic elimination used in the reduction; negative values indicate off-simplex reduced roots rather than physically admissible nonnegative 3D states.}}{4}{table.caption.15}\protected@file@percent }
\newlabel{tab:steady_states_i}{{II}{4}{Projected stationary points marked in Fig.~\ref {fig:steady_states}, with the corresponding immune coordinate $i^*$. For roots obtained from the reduced $(c,s)$ system, $i^*$ is reconstructed from the algebraic elimination used in the reduction; negative values indicate off-simplex reduced roots rather than physically admissible nonnegative 3D states}{table.caption.15}{}}
